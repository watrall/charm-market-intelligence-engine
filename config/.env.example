# --- Core flags ---
USE_SQLITE=true
USE_SHEETS=false
USE_LLM=false
USE_CLUSTERING=false

# Allow running the pipeline from the Streamlit app.
# Keep this false for shared or hosted environments.
ALLOW_PIPELINE_RUN=false

# Optional pipeline step toggles for the Streamlit wizard.
PIPELINE_SCRAPE=true
PIPELINE_REPORTS=true
PIPELINE_NLP=true
PIPELINE_SENTIMENT=true
PIPELINE_GEOCODE=true

# Identify your scraper per robots.txt guidelines
USER_AGENT="CHARM/1.0 (mailto:ENTER_CONTACT_EMAIL_HERE)"

# Geocoding (Nominatim requires a contact email in the UA)
GEOCODE_CONTACT_EMAIL=ENTER_CONTACT_EMAIL_HERE
GEOCODE_USER_AGENT=""

# Google Sheets (optional)
GOOGLE_SERVICE_ACCOUNT_FILE=ENTER_PATH_TO_SERVICE_ACCOUNT_JSON_HERE
GOOGLE_SHEET_ID=ENTER_GOOGLE_SHEET_ID_HERE
GOOGLE_SHEET_WORKSHEET=jobs
GOOGLE_SHEET_WORKSHEET_REPORTS=reports

# LLM configuration (optional)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1200
LLM_BASE_URL=""
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=ENTER_OPENAI_API_KEY_HERE

# Hugging Face hosted inference (optional)
HF_TOKEN=
HF_MODEL=
HF_INFERENCE_URL=

# Notification hooks (optional)
MATTERMOST_WEBHOOK_URL=""
DASHBOARD_URL=""
